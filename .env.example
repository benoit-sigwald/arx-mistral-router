# ==============================================================================
# ARX Mistral MCP Router — Environment Configuration Template
# ==============================================================================

# Server-side Mistral API Key (Free tier key from console.mistral.ai)
MISTRAL_API_KEY=your_mistral_api_key_here

# MCP Authentication Tokens (Bearer tokens accepted from Antigravity clients)
MISTRAL_ROUTER_TOKEN=arx_mistral_sec_token_prod_example
MISTRAL_ROUTER_TOKENS=extra_token_dev_example,extra_token_ci_example

# Set to 1 only for local unit tests without authentication (default: 0)
ALLOW_NO_AUTH=0

# Model Routing Configuration
MODEL_EXTRACTION=mistral-small-latest
MODEL_SUMMARIZATION=mistral-small-latest
MODEL_CODE=codestral-latest
MODEL_TESTS=codestral-latest
MODEL_DIFF=codestral-latest
MODEL_FALLBACK=mistral-small-latest

# Free Tier & Safety Limits
RATE_LIMIT_RPS=1.0
RATE_LIMIT_TPM=60000
MONTHLY_TOKEN_BUDGET=1000000
MAX_CONCURRENT_REQUESTS=2
MAX_INPUT_CHARS=32000
MAX_OUTPUT_TOKENS=2048
REQUEST_TIMEOUT_SECONDS=30.0
MAX_RETRIES=3

# Cache Configuration (In-Memory LRU)
CACHE_TTL_SECONDS=86400
CACHE_MAX_SIZE=256

# Server Network Settings
PORT=8000
HOST=0.0.0.0

# Optional ARX Gate Telemetry
TRACK_URL=https://arx-apps.duckdns.org/gate/t
TRACK_SITE=arxcapital
TRACK_NAME=mistral-router
